<Window x:Class="Rxdk.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Rxdk.Installer"
        mc:Ignorable="d"
        Title="RXDK Installer"
        Width="500" Height="735"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        TextElement.FontFamily="./Resources/#Orbitron"
        TextOptions.TextRenderingMode="Aliased"
        TextElement.FontSize="12"
        d:Background="Black">
    <Window.Resources>
        <ResourceDictionary Source="/WindowsStyle.xaml" />
    </Window.Resources>
    <Grid Name="MainGrid">
        <Grid.Resources>
            <ResourceDictionary>
                <DropShadowEffect x:Key="Shadow" Color="HotPink" ShadowDepth="1" BlurRadius="10" />
                <Storyboard x:Key="Anim">
                    <DoubleAnimation By="864000" Duration="10.0:0:0" Storyboard.TargetName="BackgroundShader" Storyboard.TargetProperty="Time"/>
                </Storyboard>
                <LinearGradientBrush x:Key="LinkBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="Magenta" Offset="0" />
                    <GradientStop Color="HotPink" Offset="0.25" />
                    <GradientStop Color="LightPink" Offset="0.5" />
                    <GradientStop Color="LightCyan" Offset="0.75" />
                    <GradientStop Color="Cyan" Offset="1" />
                </LinearGradientBrush>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource Anim}"/>
            </EventTrigger>
        </Grid.Triggers>
        <Rectangle Name="Background" Width="500" Height="735" Fill="Black">
            <Rectangle.Effect>
                <local:BackgroundShader x:Name="BackgroundShader" />
            </Rectangle.Effect>
        </Rectangle>
        <StackPanel Background="Transparent" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Name="Caption" Width="500">
                <StackPanel Width="440">
                    <Label Name="Title" Content="RXDK Installer" Effect="{StaticResource Shadow}" FontSize="17" MinHeight="17" Margin="10,10,0,5" IsEnabled="True">
                        <Label.RenderTransform>
                            <TranslateTransform X="170" />
                        </Label.RenderTransform>
                    </Label>
                    <Label Name="Publisher" FontSize="14" MinHeight="12" Margin="10,5,0,5" IsEnabled="False" />
                    <Label Name="Version" FontSize="14" MinHeight="12" Margin="10,5,0,5" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,5">
                    <Button Name="Minimize" Width="20" Height="20" Margin="5,0,5,0" Padding="0" HorizontalAlignment="Right" Content="-" FontSize="15" Background="Goldenrod"/>
                    <Button Name="Close" Width="20" Height="20" HorizontalAlignment="Right" Padding="0" Content="X" Background="Crimson"/>
                </StackPanel>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center">
                <Label Content="FiNE RELEASE BY" HorizontalAlignment="Center" Effect="{StaticResource Shadow}" />
                <Image Name="Logo" Source="{StaticResource LogoVector}" HorizontalAlignment="Center" Height="72" Margin="0,5,0,15">
                    <Image.RenderTransformOrigin>
                        <Point>0.5 0.5</Point>
                    </Image.RenderTransformOrigin>
                    <Image.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="40" />
                            <ScaleTransform ScaleX="2" ScaleY="1.5" />
                            <TranslateTransform Y="15" />
                        </TransformGroup>
                    </Image.RenderTransform>
                    <Image.Effect>
                        <DropShadowEffect ShadowDepth="1" Color="Magenta" BlurRadius="20" />
                    </Image.Effect>
                </Image>
                <StackPanel Effect="{StaticResource Shadow}">
                    <Label Name="Thanks" Content="THANKS TO" FontSize="10" HorizontalAlignment="Center" MinHeight="12" />
                    <Label Name="Contributors" Content="EqUiNoX and HoRnEyDvL" FontSize="12" HorizontalAlignment="Center" MinHeight="14" />
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="10">
                <Label Content="Install path" Effect="{StaticResource Shadow}" />
                <StackPanel Orientation="Horizontal" Margin="5,10" HorizontalAlignment="Stretch">
                    <TextBox Name="InstallPath" Width="380" VerticalContentAlignment="Center" CaretBrush="White" Effect="{StaticResource Shadow}" />
                    <Button Name="InstallBrowse" Width="80" Content="Browse" Margin="5,0,0,0" HorizontalAlignment="Right" Effect="{StaticResource Shadow}" />
                </StackPanel>
                <CheckBox Margin="5,0" Name="CreateDesktopShortcut" Content="Create desktop shortcut" IsChecked="True" Effect="{StaticResource Shadow}" />
            </StackPanel>

            <StackPanel Margin="10">
                <Label Content="Start menu folder" Effect="{StaticResource Shadow}" />
                <TextBox Name="StartMenuFolder" HorizontalAlignment="Left" Width="460" CaretBrush="White" Margin="5,10" Effect="{StaticResource Shadow}" />
                <CheckBox Name="CreateStartMenuFolder"  Margin="5,0" Content="Create start menu folder" IsChecked="True" Effect="{StaticResource Shadow}" />
            </StackPanel>

            <StackPanel Margin="10">
                <Label Content="Components" Effect="{StaticResource Shadow}" />
                <CheckBox Name="InstallDocs" Content="Install documentation" Margin="5,5,0,0" IsChecked="True" Effect="{StaticResource Shadow}" />
                <CheckBox Name="InstallSamples" Content="Install samples" Margin="5,5,0,0" IsChecked="True" Effect="{StaticResource Shadow}" />
            </StackPanel>

            <StackPanel Margin="10">
                <Label Content="Other" />
                <CheckBox Name="RegisterUninstall" Content="Register uninstall info" Margin="5,5,0,0" IsChecked="True" Effect="{StaticResource Shadow}" />
                <CheckBox Name="KeepIncomplete" Content="Keep files after a failed installation" Margin="5,5,0,0" IsChecked="False" Effect="{StaticResource Shadow}" />
            </StackPanel>

            <StackPanel Margin="10,0" Orientation="Horizontal">
                <Button Name="Install" Content="Install" Margin="5" Width="230" Effect="{StaticResource Shadow}" />
                <Button Name="Cancel" Content="Cancel" Margin="5" Width="230" Effect="{StaticResource Shadow}" />
            </StackPanel>

            <StackPanel Margin="10,0,10,10">
                <Grid>
                    <ProgressBar Name="TotalProgress" Height="20" Margin="5,0" Effect="{StaticResource Shadow}" />
                    <Label Name="ProgressText" HorizontalAlignment="Center" Margin="8,0" VerticalAlignment="Center" Effect="{StaticResource Shadow}" />
                </Grid>
                <TextBox Name="InstallLog" IsReadOnly="True" Height="90" Margin="5" Effect="{StaticResource Shadow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" />
            </StackPanel>

            <StackPanel Margin="10,5">
                <!--<StackPanel Orientation="Horizontal" Width="480">
                    <Label Name="Music" VerticalAlignment="Center" HorizontalAlignment="Left" Width="295" MinHeight="10" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Image Source="/Resources/quiet.png" Width="20" Height="20" />
                        <Slider Name="Volume" Minimum="0" Maximum="100" Value="50" Width="80" Margin="0,2,5,0" />
                        <Image Source="/Resources/loud.png" Width="20" Height="20" />
                        <Button Name="Play" Margin="5,0" Width="25" Height="25" Padding="5">
                            <Image Source="/Resources/play.png" Margin="0" />
                        </Button>
                        <Button Name="Pause" Width="25" Height="25" Padding="5">
                            <Image Source="/Resources/pause.png" Margin="0" />
                        </Button>
                    </StackPanel>
                </StackPanel> -->
            </StackPanel>

            <StackPanel Margin="10,5">
                <TextBlock HorizontalAlignment="Center" Effect="{StaticResource Shadow}">
                    <Hyperlink Foreground="{StaticResource LinkBrush}" TextDecorations="None" NavigateUri="https://discord.com/invite/VcdSfajQGK">JOiN US ON DiSCORD</Hyperlink>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
