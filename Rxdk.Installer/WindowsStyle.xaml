						<Path.Fill>
							<LinearGradientBrush EndPoint="1,0.7" StartPoint="0,0">
								<GradientStop Color="#CC000000" Offset="0"/>
								<GradientStop Color="#7F000000" Offset="0.5"/>
								<GradientStop Color="#33000000" Offset="0.75"/>
